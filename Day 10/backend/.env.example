PORT=5000
NODE_ENV=development

# NASA Earth Observation APIs
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
ISRIC_SOILGRIDS_API_BASE=https://rest.isric.org/soilgrids/v2.0/properties/query
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1/forecast

# Optional Supabase / PostgreSQL Credentials (if connecting live database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/terrashift

# Cache TTL Configuration (in seconds)
CACHE_TTL_SECONDS=21600
API_REQUEST_TIMEOUT_MS=6000
